# .dockerignore for the commit-image build. Bake in the FULL repo (incl. .git history — the grader
# uses it), dropping only local build artifacts and editor/OS cruft.
build/
dist/
*.o
*.a
*.so
*.dylib
**/__pycache__/
*.pyc
.tox/
.nox/
.mypy_cache/
.pytest_cache/

# Editor / OS noise
.DS_Store
*.swp
*~
